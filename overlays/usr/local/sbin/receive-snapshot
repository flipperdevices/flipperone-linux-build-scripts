#!/bin/sh
# receive-snapshot <file> - receive a send-snapshot stream. Regular snapshots land in
# @snapshots; a _stock golden base is relocated to the top level (where create-profile and
# migrate-profile look for it). The received subvolume keeps the name it had when sent (the
# leading '@' too, carried in the stream) and is read-only; put a snapshot onto a root with
# create-profile. For an incremental stream (sent with -p/-i), its parent must already exist
# here (e.g. the _stock base it was diffed against, found by UUID wherever it lives), so
# receive the full base first.
#
# Examples:
#   receive-snapshot /mnt/usb/SourceProfile_2026-..._pack.zst      # -> @snapshots/@SourceProfile...
#   receive-snapshot /mnt/usb/SourceProfile_2026-..._inc_pack.zst  # needs the matching @SourceProfile_stock
#   ssh host 'send-snapshot @SourceProfile -' | receive-snapshot -
set -eu
. /usr/lib/flipper-btrfs.sh 2>/dev/null || { echo "Error: /usr/lib/flipper-btrfs.sh not found" >&2; exit 1; }

usage() {
    cat <<EOF
Usage: receive-snapshot <file|->
  Receive a send-snapshot stream (read-only). Snapshots land in @snapshots (deploy with
  create-profile); a _stock golden base is relocated to the top level. Incremental streams
  need their parent to exist here first.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    -?*)       echo "Error: unknown option: $1" >&2; usage >&2; exit 1 ;;
esac
[ $# -ge 1 ] || { usage >&2; exit 1; }
src=$1

need_root
need_btrfs
need_cmd zstd "apt install zstd"
have_pv=0; command -v pv >/dev/null 2>&1 && have_pv=1
[ "$src" = "-" ] || [ -f "$src" ] || die "No such file: $src"

set_lock
mount_top
target="$TOP/@snapshots"
[ -d "$target" ] || die "@snapshots not found at top level"

# names of subvolumes under @snapshots, so we can tell which one the receive just created
snaplist() { btrfs subvolume list -o "$target" 2>/dev/null | sed -n 's,.*[[:space:]]@snapshots/,,p' | sort; }
before_f=$(mktemp); after_f=$(mktemp); TOP_TMPFILES="$before_f $after_f"
snaplist > "$before_f"

# file src -> pv shows %/ETA; silence zstd so the two don't collide on one line.
# No pipefail in POSIX sh, so the pipeline's status is btrfs receive's (the meaningful end).
set +e
if   [ "$have_pv" = 1 ] && [ "$src" != "-" ]; then pv "$src" | zstd -dc --no-progress | btrfs receive "$target"
elif [ "$have_pv" = 1 ];                      then zstd -dc --no-progress | pv -btr   | btrfs receive "$target"
elif [ "$src" != "-" ];                       then zstd -dc "$src"        | btrfs receive "$target"
else                                               zstd -dc               | btrfs receive "$target"
fi
rc=$?
set -e
[ "$rc" = 0 ] || die "Receive failed (rc=$rc); check the stream and that any parent snapshot exists here"

# a _stock is a golden base, not a snapshot: move it to the top level so create-profile and
# migrate-profile find it (they look for $TOP/<name>_stock). Everything else stays in @snapshots.
snaplist > "$after_f"
new=$(comm -13 "$before_f" "$after_f")
[ -n "$new" ] || { echo "Received into @snapshots/ (could not identify the new subvolume by name)"; exit 0; }
moved=""; stayed=""
for leaf in $new; do
    case "$leaf" in
        *_stock)
            if [ -e "$TOP/$leaf" ]; then
                echo "WARN: '$leaf' already exists at top level; left in @snapshots" >&2; stayed="$stayed $leaf"
            elif mv "$TOP/@snapshots/$leaf" "$TOP/$leaf"; then
                moved="$moved $leaf"
            else
                echo "WARN: could not move '$leaf' to top level; left in @snapshots" >&2; stayed="$stayed $leaf"
            fi ;;
        *) stayed="$stayed $leaf" ;;
    esac
done
echo "Received:"
[ -n "$moved" ]  && echo "  top level (golden base, ready for create-profile/migrate-profile):$moved"
[ -n "$stayed" ] && echo "  @snapshots/ (deploy with create-profile):$stayed"

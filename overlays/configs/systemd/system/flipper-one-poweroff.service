[Unit]
Description=Report imminent power-off to the Flipper One MCU
DefaultDependencies=no
Before=shutdown.target
ConditionPathExistsGlob=/sys/bus/i2c/drivers/flipper-one-mcu/*/cpustate

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for f in /sys/bus/i2c/drivers/flipper-one-mcu/*/cpustate; do echo poweroff-request > "$f"; done'

[Install]
WantedBy=poweroff.target

[Unit]
# One gadget configuration can own the UDC, so starting one stops whichever is running
# and lets its ExecStopPost tear the gadget down first. Conflicts without a matching
# After=: five units each naming the other four would be an ordering cycle.
Conflicts=usb-msc-gadget.service usb-ncm-gadget.service usb-ncm-msc-gadget.service usb-ncm-msc-mtp-gadget.service
Description=USB Composite Gadget Setup (NCM Ethernet + MTP + Serial)
After=sys-kernel-config.mount local-fs.target
Requires=sys-kernel-config.mount
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usb-ncm-mtp-acm-gadget.sh start
ExecStopPost=/usr/local/bin/usb-ncm-mtp-acm-gadget.sh stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

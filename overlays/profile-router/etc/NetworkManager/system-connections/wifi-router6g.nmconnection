# 6 GHz doesn't seem to work yet, TODO: investigate and fix
[connection]
id=Router Wi-Fi 6 GHz
type=wifi
autoconnect=false
master=br-lan
slave-type=bridge

[wifi]
band=a
channel=5
channel-width=80
mode=ap
ssid=FlipperOne_6GHz_WIFISSIDSERIAL

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
psk=flipperone
